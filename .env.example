# ==============================================================================
# EduPlatform Environment Variables & API Keys Configuration
# ==============================================================================
# NOTE: Secrets and API keys are securely managed via the AI Studio Settings menu.
# The platform will automatically prompt for and inject these secrets into the runtime.
# Do NOT commit actual production secrets to this file.

# ------------------------------------------------------------------------------
# Core AI & Platform Services
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Automatically injected by AI Studio from user secrets at runtime.
GEMINI_API_KEY=""

# APP_URL: The hosting URL for this applet (injected at runtime).
APP_URL=""

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway & Settlements
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID: Public/Key ID for payment gateway order creation & checkout
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Secret key for HMAC-SHA256 signature verification & refunds
RAZORPAY_KEY_SECRET=""

# RAZORPAY_WEBHOOK_SECRET: Secret for validating incoming Razorpay webhook events
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# CRM, Messaging & Marketing Channels (Optional Server-Side Integrations)
# ------------------------------------------------------------------------------
# WHATSAPP_VERIFY_TOKEN: Token for Meta/WhatsApp Cloud API webhook subscription handshake
WHATSAPP_VERIFY_TOKEN=""

# WHATSAPP_ACCESS_TOKEN: Cloud API Bearer token for outbound WhatsApp template messaging
WHATSAPP_ACCESS_TOKEN=""

# SENDGRID_API_KEY: API key for automated transactional & admission campaign emails
SENDGRID_API_KEY=""

